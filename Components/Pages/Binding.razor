@page "/binding"
@inject NavigationManager NavManager
@rendermode InteractiveServer

<h3> two way data Binding</h3>
<input type="text" @bind="name" @bind:event="oninput"/>
<hr />
<h2>Your name is: @name</h2>
<hr/>

<NavLink href="/about us">About Us</NavLink><br />	
<NavLink href="/contact">Contact Us</NavLink><br/>
<NavLink href="/description">Description</NavLink>
<hr />	
<button class="btn btn-primary" @onclick="AnotherPage"> AnotherPage </button>

@code {
	string name = "";

	void AnotherPage()
	{
		NavManager.NavigateTo("/otherpage");
	}
}
